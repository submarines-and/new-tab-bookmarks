{
    "manifest_version": 3,
    "name": "Chrome Enhancements",
    "version": "0.2",
    "description": "Various changes to chrome.",
    "author": "submarines",
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "bookmarks",
        "tabGroups",
        "storage"
    ],
    "icons": {
        "16": "16.png",
        "19": "19.png",
        "38": "38.png",
        "48": "48.png",
        "128": "128.png"
    }
}